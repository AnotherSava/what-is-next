# Reference list of all config variables — values live in Doppler (whats-next/dev).
# Set them with: doppler secrets set KEY=value -p whats-next -c dev
# For deploy without Doppler, copy this to .env and fill in real values (Next.js auto-loads .env).

# SQLite database file. Dev: relative to web/. Prod (Docker): file:/data/whats-next.db
DATABASE_URL="file:./prisma/dev.db"

# Owner login password (single-owner console)
ADMIN_PASSWORD="change-me"

# Secret for signing the owner session cookie, and for deriving the key that encrypts the media-server
# tokens stored in the database. Changing it signs everyone out AND makes stored tokens unreadable (each
# server then reports as disconnected until its token is re-entered on the Settings page). Generate with:
#   node -e "console.log(crypto.randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me-64-hex-chars"

# TMDB v4 Read Access Token (Bearer). Register free at https://www.themoviedb.org/settings/api
TMDB_API_TOKEN="change-me"

# --- OMDb (optional; adds IMDb ratings to movie cards; feature degrades to TMDB-only when unset) ---
# Free API key from https://www.omdbapi.com/apikey.aspx — activate it via the emailed link before use.
# OMDB_API_KEY="your-omdb-api-key"

# Public access mode: "readonly" (default — anyone can browse read-only) | "off" (owner-only; viewers redirected to /login)
PUBLIC_ACCESS="readonly"

# Nightly metadata-refresh schedule (cron, UTC). Optional; default 0 11 * * * (~4am Pacific).
# REFRESH_CRON="0 11 * * *"

# Timezone for date rendering and cron. Optional; default host TZ.
TZ="America/Vancouver"

# --- Media servers: Plex + Jellyfin (both optional; either, neither, or both) ---
# These are a FIRST-RUN SEED ONLY. Connections are configured on the Settings page (/admin) and stored in the
# database; the values below only populate that row the first time the app reads it, and are ignored afterwards.
# A server with a token here starts out enabled, matching how the Plex integration used to gate itself.
#
# Base URL of your Plex Media Server (e.g. http://localhost:32400, or http://<server-ip>:32400 on a VPS).
# PLEX_URL="http://localhost:32400"
# A Plex auth token (X-Plex-Token). Find it via https://support.plex.tv/articles/204059436-finding-an-authentication-token-x-plex-token/
# PLEX_TOKEN="your-plex-token"
# Optional: restrict the sync to specific Plex library titles (comma-separated). Unset = all TV+movie libraries.
# PLEX_LIBRARIES="TV Shows,Movies"
#
# Base URL of your Jellyfin server. A bare host gets http:// and :8096 added.
# JELLYFIN_URL="http://localhost:8096"
# A Jellyfin API key (Dashboard -> API Keys).
# JELLYFIN_API_KEY="your-jellyfin-api-key"
# Jellyfin watch state is per account: pick which one to read on the Settings page. Required when the server has
# more than one account (the sync reports the available names if it isn't set).
#
# On-view freshening (stale-while-revalidate): max age (seconds) before a sync is triggered — on open, on tab
# focus, and on a periodic poll while a tab stays open. Default 60 (1 min); the header freshness dot turns yellow
# past 1.5 min and red past 3x this window. Lower = fresher watch state, more reads; higher = fewer reads.
# MEDIA_VIEW_TTL_SECONDS="60"

# --- TVDB fallback (optional; hydrates titles TMDB can't resolve, e.g. fan/web content) ---
# TVDB v4 API key. Register at https://thetvdb.com/dashboard → API keys (free under $50k revenue, with attribution).
# TVDB_API_KEY="your-tvdb-api-key"
# Subscriber PIN — ONLY for a "user-supported" key (paired with a TVDB subscription). Omit for a licensed key.
# TVDB_PIN="your-subscriber-pin"
